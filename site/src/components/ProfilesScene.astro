<section id="profiles" class="scene profiles-scene" data-motion-scene="profiles">
  <div class="site-shell">
    <div class="profiles-heading">
      <p class="operational-label">Three fit states. One deliberate setup.</p>
      <h2>Every repo gets the right kit.</h2>
    </div>

    <div class="profile-bands">
      <article class="profile-band universal-band">
        <header><span>U</span><h3>Universal</h3></header>
        <p>Always available; safe in every repository.</p>
        <ul aria-label="Universal plugins">
          <li data-profile-card>filesystem</li>
          <li data-profile-card>memory</li>
        </ul>
      </article>

      <article class="profile-band matched-band">
        <header><span>P</span><h3>Profile</h3></header>
        <p>Enabled when repository signals match.</p>
        <ul aria-label="Profile plugins">
          <li data-profile-card>github</li>
          <li data-profile-card>browser</li>
          <li data-profile-card>docs</li>
        </ul>
      </article>

      <article class="profile-band demand-band">
        <header><span>O</span><h3>On-demand</h3></header>
        <p>Borrowed only for the current session.</p>
        <ul aria-label="On-demand plugins">
          <li data-profile-card>figma</li>
          <li data-profile-card>calendar</li>
        </ul>
      </article>
    </div>
  </div>
</section>
