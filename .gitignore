# User-customized config (template lives at profiles.example.json).
# install.sh seeds ~/.claude/profiles/profiles.json from the template; the
# canonical config thereafter lives there, not in the repo working tree.
/profiles.json
/node_modules/
/site/node_modules/
/site/.astro/
/site/dist/

# Superpowers / brainstorming intermediate artifacts — kept locally, not committed
docs/superpowers/
/.superpowers/
/.worktrees/
*.plan.md
plans/

# Editor / OS
.DS_Store
*.swp

# serena's per-project cache (regenerated on demand by the MCP server)
/.serena/

# Rust build output
/target

# Cargo cache in CI (keep audit.toml tracked)
/.cargo/*
!/.cargo/audit.toml
